-- *************************************************************************************************
--   This table will hold a list of valid logging levels as defined by the Internet Engineering
-- Task Force in RFC5424. We define constants in qcpysrc/constantsk.rpgleinc for each of these log
-- levels - those constants are in parenthesis below:
--
-- 0 = Emergency: system is unusable (C_SDK4I_LL_EMG)
-- 1 = Alert: action must be taken immediately (C_SDK4I_LL_ALT)
-- 2 = Critical: critical conditions (C_SDK4I_LL_CRT)
-- 3 = Error: error conditions (C_SDK4I_LL_ERR)
-- 4 = Warning: warning conditions (C_SDK4I_LL_WRN)
-- 5 = Notification: normal but significant condition (C_SDK4I_LL_NTF)
-- 6 = Informational: informational messages (C_SDK4I_LL_INF)
-- 7 = Debug: debug-level messages (C_SDK4I_LL_DBG)
--
-- @copyright Copyright (c) 2015 - 2026 by James Brian Hill
-- @license GNU General Public License version 3
-- @link https://www.gnu.org/licenses/gpl-3.0.html
-- @link https://datatracker.ietf.org/doc/html/rfc5424
-- *************************************************************************************************

-- *************************************************************************************************
--   This program is free software: you can redistribute it and/or modify it under the terms of the
-- GNU General Public License as published by the Free Software Foundation, either version 3 of the
-- License, or (at your option) any later version.
--
--   This program is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
-- without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
-- GNU General Public License for more details.
--
--   You should have received a copy of the GNU General Public License along with this program. If
-- not, see https://www.gnu.org/licenses/gpl-3.0.html
-- *************************************************************************************************

-- *************************************************************************************************
-- Create the table.
-- *************************************************************************************************
CREATE OR REPLACE TABLE sdk4i_log_level FOR SYSTEM NAME loglvlt (
  -- Primary key column.
  id
    DECIMAL(1,0) NOT NULL,

  -- Data columns.
  code -- LL_EMG, LL_ALT, LL_CRT, LL_ERR, LL_WRN, LL_NTF, LL_INF, and LL_DBG.
    CHAR(6) NOT NULL,

  description FOR dsc
    VARCHAR(50) NOT NULL,

  -- Constraints.
  CONSTRAINT loglvltpk PRIMARY KEY(id),
  CONSTRAINT loglvltu00 UNIQUE(code)
);

-- *************************************************************************************************
-- Label the table.
-- *************************************************************************************************
LABEL ON TABLE loglvlt IS 'SDK4i - LOG - Log Levels';

-- *************************************************************************************************
-- Label the columns.
-- *************************************************************************************************
LABEL ON COLUMN loglvlt (
  id   IS 'ID',
  code IS 'Code',
  dsc  IS 'Description'
);