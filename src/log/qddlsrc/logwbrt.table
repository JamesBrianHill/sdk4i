-- *************************************************************************************************
--   This table will hold log information related to remotely hosted web services.
--
-- IMPORTANT: if you change the size of req_body or rsp_body, you MUST change the definition of
-- those fields in:
-- * The DCL-DS tpl_sdk4i_logwbrt_ds definition in src/qcpysrc/logk.rpgleinc.
-- * The SaveRemoteWebServiceInfo procedure in src/log/qrpglesrc/log.sqlrpgle.
--
