-- *************************************************************************************************
-- Create the table.
-- *************************************************************************************************
CREATE OR REPLACE TABLE sdk4i_vld_message FOR SYSTEM NAME vldmsgt (
  -- Primary key column.
  id
    VARCHAR(50) NOT NULL,

  -- Data columns.
  lng_id
    CHAR(2) NOT NULL DEFAULT 'en',
  msg
    VARCHAR(1024) NOT NULL CCSID 1208,

  -- Constraints.
  CONSTRAINT vldmsgtpk PRIMARY KEY(id),
  CONSTRAINT vldmsgtu00 UNIQUE(id, lng_id),
  CONSTRAINT vldmsgtf00 FOREIGN KEY(lng_id) REFERENCES lngt(id) ON DELETE RESTRICT
);

-- *************************************************************************************************
-- Label the table.
-- *************************************************************************************************
LABEL ON TABLE vldmsgt IS 'SDK4i - VLD - Validation Messages';

-- *************************************************************************************************
-- Label the columns.
-- *************************************************************************************************
LABEL ON COLUMN vldmsgt (
  id     IS 'ID',
  lng_id IS 'Language',
  msg    IS 'Message'
);