[
  {
    "name": "Create RPGLE Program",
    "command": "?CRTBNDRPG PGM(&CURLIB/&NAME) SRCSTMF('&RELATIVEPATH') DBGVIEW(*SOURCE) OPTION(*EVENTF) PPMINOUTLN(240)",
    "deployFirst": true,
    "environment": "ile",
    "extensions": [
      "RPGLE"
    ]
  },
  {
    "name": "Create RPGLE Module",
    "command": "?CRTRPGMOD MODULE(&CURLIB/&NAME) SRCSTMF('&RELATIVEPATH') DBGVIEW(*SOURCE) OPTION(*EVENTF) PPMINOUTLN(240)",
    "deployFirst": true,
    "environment": "ile",
    "extensions": [
      "RPGLE"
    ]
  },
  {
    "name": "Create SQLRPGLE Program",
    "command": "?CRTSQLRPGI OBJ(&CURLIB/&NAME) SRCSTMF('&RELATIVEPATH') CLOSQLCSR(*ENDACTGRP) COMPILEOPT('PPMINOUTLN(240)') DATFMT(*ISO) DBGVIEW(*SOURCE) OPTION(*EVENTF) OUTPUT(*PRINT) RPGPPOPT(*LVL2) TIMFMT(*ISO)",
    "deployFirst": true,
    "environment": "ile",
    "extensions": [
      "SQLRPGLE"
    ]
  },
  {
    "name": "Create SQLRPGLE Module",
    "command": "?CRTSQLRPGI OBJ(&CURLIB/&NAME) SRCSTMF('&RELATIVEPATH') CLOSQLCSR(*ENDACTGRP) COMPILEOPT('PPMINOUTLN(240)') DATFMT(*ISO) DBGVIEW(*SOURCE) OBJTYPE(*MODULE) OPTION(*EVENTF) OUTPUT(*PRINT) RPGPPOPT(*LVL2) TIMFMT(*ISO)",
    "deployFirst": true,
    "environment": "ile",
    "extensions": [
      "SQLRPGLE"
    ]
  },
  {
    "name": "Create Bound CL Program",
    "command": "?CRTBNDCL PGM(&CURLIB/&NAME) SRCSTMF('&RELATIVEPATH') DBGVIEW(*SOURCE) OPTION(*EVENTF)",
    "deployFirst": true,
    "environment": "ile",
    "extensions": [
      "CLP",
      "CLLE"
    ]
  },
  {
    "name": "Run SQL Statements (RUNSQLSTM)",
    "command": "?RUNSQLSTM SRCSTMF('&FULLPATH') COMMIT(*NONE) NAMING(*SQL)",
    "deployFirst": true,
    "environment": "ile",
    "extensions": [
      "SQL",
      "TABLE",
      "VIEW",
      "SQLPRC",
      "SQLUDF",
      "SQLUDT",
      "SQLTRG",
      "SQLALIAS",
      "SQLSEQ"
    ]
  },
  {
    "name": "Create DSPF",
    "command": "?CRTDSPF FILE(&CURLIB/&NAME) OPTION(*EVENTF) RSTDSP(*NO) SRCFILE(&SRCFILE)",
    "deployFirst": true,
    "environment": "ile",
    "extensions": [
      "dspf"
    ]
  },
  {
    "name": "Create Service Program (CRTSRVPGM with source)",
    "command": "?CRTSRVPGM SRVPGM(&CURLIB/&NAME) SRCSTMF('&RELATIVEPATH') ACTGRP(*CALLER) BNDDIR(*NONE) BNDSRVPGM(*NONE)",
    "deployFirst": true,
    "environment": "ile",
    "extensions": [
      "BND",
      "BINDER"
    ]
  }
]
